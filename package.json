{
  "name": "apuracao",
  "version": "1.0.0",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "nodemon backend/src/server.js",
    "db:init": "psql -h localhost -U postgres -d apuracao_votos -f database/schema.sql",
    "db:seed": "psql -h localhost -U postgres -d apuracao_votos -f database/seed.sql",
    "test": "node --check backend/src/server.js && node --check backend/src/app.js && node --check backend/src/auth.js && node --test test/*.test.js"
  },
  "keywords": [
    "eleicao",
    "apuracao",
    "votos",
    "postgres",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "description": "Sistema completo de apuração e acompanhamento de votos",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csvtojson": "^2.0.14",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  }
}
